# ============================================================
# GovBridge — Environment Variables Example
# Copy this file to .env and fill in values
# ============================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=govbridge
POSTGRES_USER=govbridge_user
POSTGRES_PASSWORD=govbridge_password
DATABASE_URL=postgresql://govbridge_user:govbridge_password@postgres:5432/govbridge

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# --- Mock Service URLs ---
MOCK_IDENTITY_URL=http://mock-identity:8001
MOCK_EDUCATION_URL=http://mock-education:8002
MOCK_EMPLOYMENT_URL=http://mock-employment:8003
MOCK_SKILL_URL=http://mock-skill:8004
MOCK_REVENUE_URL=http://mock-revenue:8005
MOCK_WELFARE_URL=http://mock-welfare:8006

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=GovBridge
